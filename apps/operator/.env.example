# Supabase (public values: safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only: set in the host's environment, never in the repo

# Platform links (all optional; defaults are the platform address)
# NEXT_PUBLIC_OPERATOR_URL=https://winjo-dispatch.vercel.app
# NEXT_PUBLIC_DRIVER_APP_URL=https://winjo-dispatch.vercel.app/driver
# DRIVER_APP_URL=https://winjo-dispatch.vercel.app/driver
# NEXT_PUBLIC_WEBSITE_URL=https://winjo-dispatch.vercel.app
# NEXT_PUBLIC_BRAND_NAME=Winjo Dispatch

# Stripe (server-only; set in the host's environment, never expose with NEXT_PUBLIC).
# STRIPE_PLATFORM_SECRET_KEY=sk_test_...   # the platform account used for Stripe Connect
# NEXT_PUBLIC_SITE_URL=https://winjo-dispatch.vercel.app  # base for Stripe success/cancel redirects
# STRIPE_WEBHOOK_SECRET=whsec_...   # signing secret from the Stripe webhook endpoint
#   Subscribe to: checkout.session.completed (marks the booking Paid automatically)

# Flight verification (supabase/functions/verify-flight): NOT a Vercel env var.
# This is a Supabase Edge Function secret: set it with
#   supabase secrets set AERODATABOX_API_KEY=your_key_here
# or via Dashboard -> Project Settings -> Edge Functions -> Secrets.
# Key from: https://rapidapi.com/aedbx-aerodatabox (AeroDataBox API)
# AERODATABOX_API_KEY=
