# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...   # must start with whsec_ (the endpoint's signing secret)
STRIPE_PUBLISHABLE_KEY=
# Other businesses' payments (Stripe Connect, Winjo Digital's own account). Create as Sensitive in Vercel.
STRIPE_PLATFORM_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Which business owns the platform Stripe account / default business. Defaults to the first tenant.
STRIPE_PLATFORM_TENANT_ID=
TENANT_ID=

# Twilio SMS. DORMANT by owner decision: nothing is sent unless SMS_ENABLED=true,
# and SMS_ENABLED must stay unset without the owner's approval (it is billed).
# SMS_ENABLED=
# WHATSAPP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+44...

# Resend email
RESEND_API_KEY=re_...
RESEND_FROM=
REPLY_TO=

# Operator contact details
OPERATOR_PHONE=+447721070370
OPERATOR_EMAIL=book@evexec.co.uk

# Secure token for accept/reject links (generate with: openssl rand -hex 32)
OPERATOR_ACTION_SECRET=

# evexecoperator's base URL, used to push-notify staff for the two-tap SMS
# automation (see lib/notify.js's handOffSmsToOperator). Defaults to
# https://evexecoperator.vercel.app if unset.
OPERATOR_APP_URL=https://evexecoperator.vercel.app

# Site URL (no trailing slash)
SITE_URL=https://evexec.co.uk

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:book@evexec.co.uk

# Cron endpoints (/api/reminders/trigger, /api/notifications/retry): Vercel sends this as a bearer token
CRON_SECRET=

# Driver App base URL, used in driver emails. Defaults to https://evexecdriverapp.vercel.app
DRIVER_APP_URL=

# Browser keys returned by /api/config (public by design; restrict them by domain in Google/Stripe)
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# Password for the leads endpoint (api/leads.js). Leave unset to keep it closed.
ADMIN_PASSWORD=

# Platform sign-up (/signup). These are the platform's own emails, never a business's.
# PLATFORM_FROM must be an address verified in Resend; with it unset, no sign-up emails are sent.
PLATFORM_FROM=
PLATFORM_REPLY_TO=
PLATFORM_OWNER_EMAIL=
# Used for the link to the terms in the applicant's email. Defaults to the address the form was sent from.
PLATFORM_SITE_URL=
